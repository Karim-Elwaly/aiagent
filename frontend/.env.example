# Fleet Studio Backend Settings
# By default, Fleet Studio uses SQLite (zero-config, same as UAOS memory DB):
FLEET_STUDIO_DATABASE_URL=sqlite+aiosqlite:///./fleet_studio.db
# Or if using PostgreSQL via Docker (deploy/docker-compose.yml):
# FLEET_STUDIO_DATABASE_URL=postgresql+asyncpg://fleet:fleet@localhost:5432/fleet_studio

FLEET_STUDIO_HERMES_BASE_URL=http://127.0.0.1:9119
FLEET_STUDIO_AUTH_REQUIRED=false
FLEET_STUDIO_FRONTEND_ORIGIN=http://localhost:3000
FLEET_STUDIO_LLM_BASE_URL=http://10.7.75.103:1234/v1
FLEET_STUDIO_LLM_MODEL=openai/gpt-oss-20b
FLEET_STUDIO_SESSION_SECRET=local-development-only-change-me

# Fleet Studio Frontend Settings
NEXT_PUBLIC_API_URL=
PORT=3000
FLEET_STUDIO_API_URL=http://127.0.0.1:8001
UAOS_API_URL=http://127.0.0.1:8000
