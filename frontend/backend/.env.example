# Database Configuration
# Option 1 (Zero-config local SQLite - no PostgreSQL or Docker needed):
# FLEET_STUDIO_DATABASE_URL=sqlite+aiosqlite:///fleet_studio.db

# Option 2 (PostgreSQL - default):
FLEET_STUDIO_DATABASE_URL=postgresql+asyncpg://fleet:fleet@localhost:5432/fleet_studio

# Hermes & LLM Settings
FLEET_STUDIO_HERMES_BASE_URL=http://127.0.0.1:9119
FLEET_STUDIO_AUTH_REQUIRED=false
FLEET_STUDIO_FRONTEND_ORIGIN=http://localhost:3000
FLEET_STUDIO_SESSION_SECRET=local-development-only-change-me

