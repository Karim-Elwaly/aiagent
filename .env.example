# Environment Configuration for UAOS (Universal Agent Orchestration System)

# LLM Configuration (Local Ollama, vLLM, LM Studio, or llama.cpp)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120.0

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=uaos-tasks

# Worker Guardrails
WORKER_MAX_ITERATIONS=10
WORKER_STEP_TIMEOUT=60.0
WORKER_MAX_OBSERVATION_CHARS=4000

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
